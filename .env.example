# ============================================================
# Stock Trading Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Application ---
APP_ENV=development           # development | production
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
DEBUG=true

# --- Database ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trader:changeme@postgres:5432/trading_platform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Market Data: Alpaca ---
# Get free API keys at: https://alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper trading endpoint
ALPACA_DATA_URL=https://data.alpaca.markets

# --- News & Sentiment: Finnhub ---
# Free tier at: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key

# --- LLM Provider (configurable) ---
# Set LLM_PROVIDER to one of: openai | anthropic | ollama
LLM_PROVIDER=ollama

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (if LLM_PROVIDER=ollama) — runs locally, no key needed
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-another-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Risk Management Defaults ---
MAX_POSITION_SIZE_PCT=5        # max % of portfolio per position
MAX_PORTFOLIO_RISK_PCT=20      # max % of portfolio at risk
DAILY_LOSS_LIMIT_PCT=3         # kill switch: halt trading if daily loss exceeds this %

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000
